# ==============================================
# TruePeopleSearch Scraper - Proxy Configuration
# ==============================================
# Replace these with your own proxy credentials

# Proxy Provider (supports any HTTP/HTTPS proxy)
PROXY_HOST=your-proxy-host.com
PROXY_PORT=33335
PROXY_USERNAME=your-proxy-username
PROXY_PASSWORD=your-proxy-password

